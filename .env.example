# Copy this file to .env and fill in the values
# cp .env.example .env

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=training_db
DB_PORT=5434

# ── API ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# Public URL of the API server
NEXTAUTH_URL=https://api.yourapp.com
API_BASE_URL=https://api.yourapp.com
# Public URL of the web app
FRONTEND_URL=https://yourapp.com
NEXT_PUBLIC_WEB_URL=https://yourapp.com

# ── OAuth: Google Login ───────────────────────────────────────────────────────
# Google Cloud Console authorized redirect URI:
# https://api.yourapp.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: Strava ─────────────────────────────────────────────────────────────
# Strava authorized callback domain:
# https://api.yourapp.com/api/v1/client/sync/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ── Web ───────────────────────────────────────────────────────────────────────
# URL that the BROWSER uses to reach the API (baked in at build time)
NEXT_PUBLIC_API_URL=https://api.yourapp.com/api/v1

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=YourCoach <noreply@yourapp.com>

# ── Push (Web Push / VAPID) ───────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourapp.com

# ── Health sync OAuth ─────────────────────────────────────────────────────────
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Optional; falls back to JWT_SECRET
HEALTH_OAUTH_STATE_SECRET=

# ── Garmin (legacy fallback; do not rely on this in production) ───────────────
GARMIN_PASSWORD_FALLBACK=

# ── Ops ───────────────────────────────────────────────────────────────────────
CRON_SECRET=
PORT=3003
