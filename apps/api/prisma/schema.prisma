// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  role         String   // 'coach' | 'client' | 'gym'
  email        String   @unique
  passwordHash String?
  googleId   String?   @unique
  displayName  String?
  avatarUrl    String?
  billingStatus       String    @default("good") // 'good' | 'due'
  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?
  emailVerified       Boolean   @default(false)
  emailVerifyToken    String?   @unique
  emailVerifyExpiry   DateTime?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  refreshToken        String?   @unique
  refreshTokenExpiry  DateTime?
  
  // Gamification fields
  currentWorkoutStreak   Int       @default(0)
  longestWorkoutStreak   Int       @default(0)
  lastWorkoutDate        DateTime?
  xp                     Int       @default(0)
  level                  Int       @default(1)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  coachClientsAsCoach   CoachClient[]      @relation("CoachClients")
  coachClientsAsClient  CoachClient[]      @relation("ClientCoach")
  chatThreadsAsCoach    ChatThread[]       @relation("ChatCoach")
  chatThreadsAsClient   ChatThread[]       @relation("ChatClient")
  chatMessages          ChatMessage[]
  plansCreated          Plan[]             @relation("CoachPlans")
  planAssignments       PlanAssignment[]
  exercisesCreated      Exercise[]         @relation("CoachExercises")
  workoutTemplates      WorkoutTemplate[]  @relation("CoachWorkoutTemplates")
  workoutSessions       WorkoutSession[]
  sessionComments       SessionComment[]
  bodyMetricEntries     BodyMetricEntry[]
  dailyHealthEntries    DailyHealthEntry[]
  healthCoachNotesAsCoach HealthCoachNote[] @relation("HealthNotesCoach")
  healthCoachNotesAsClient HealthCoachNote[] @relation("HealthNotesClient")
  foodLogEntries        FoodLogEntry[]
  foodCoachCommentsAsCoach FoodCoachComment[] @relation("FoodCoachCommentCoach")
  healthGoals           HealthGoal[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  badges                UserBadge[]
  healthDataSyncs       HealthDataSync[]
  healthProviderConnections HealthProviderConnection[]
  notificationSettings      NotificationSettings?
  exerciseFavorites         CoachExerciseFavorite[]
  coachInvites              CoachInvite[]
  coachGroups               CoachGroup[]
  groupMemberships          CoachGroupMember[]
  gymClasses                GymClass[]
  
  // Challenges
  challengesCreated         Challenge[] @relation("CoachChallenges")
  challengeParticipations   ChallengeParticipant[]
  
  // Social / Friends
  following                 UserFollow[] @relation("UserFollowing")
  followers                 UserFollow[] @relation("UserFollowers")
  
  // Athlete Solo
  athleteOnboarding         AthleteOnboarding?
}

model CoachClient {
  id           String   @id @default(uuid())
  coachUserId  String
  clientUserId String
  status       String   // 'active' | 'inactive'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coach  User @relation("CoachClients", fields: [coachUserId], references: [id], onDelete: Restrict)
  client User @relation("ClientCoach", fields: [clientUserId], references: [id], onDelete: Restrict)

  @@unique([coachUserId, clientUserId])
  @@index([coachUserId])
  @@index([clientUserId])
}

model CoachInvite {
  id          String   @id @default(uuid())
  coachUserId String
  email       String
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  coach User @relation(fields: [coachUserId], references: [id], onDelete: Cascade)

  @@unique([coachUserId, email])
  @@index([token])
}

model CoachGroup {
  id          String   @id @default(uuid())
  coachUserId String
  name        String
  level       String?  // 'beginner' | 'intermediate' | 'advanced'
  tags        String[] @default([])
  createdAt   DateTime @default(now())

  coach   User               @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  members CoachGroupMember[]
  classes  GymClass[]
  challenges Challenge[]

  @@unique([coachUserId, name])
  @@index([coachUserId])
}

model CoachGroupMember {
  id           String   @id @default(uuid())
  groupId      String
  clientUserId String
  createdAt    DateTime @default(now())

  group  CoachGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  client User       @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, clientUserId])
  @@index([clientUserId])
}

model GymClass {
  id                String   @id @default(uuid())
  gymUserId         String
  name              String
  description       String?
  workoutTemplateId String
  groupId           String?
  scheduledAt       DateTime @db.Timestamptz
  durationMinutes   Int      @default(60)
  status            String   @default("scheduled") // scheduled|in_progress|completed|cancelled
  currentExercise   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  gym             User              @relation(fields: [gymUserId], references: [id], onDelete: Cascade)
  workoutTemplate WorkoutTemplate   @relation(fields: [workoutTemplateId], references: [id], onDelete: Restrict)
  group           CoachGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sessions        WorkoutSession[]

  @@index([gymUserId, scheduledAt(sort: Desc)])
  @@index([workoutTemplateId])
  @@index([groupId])
}

model Plan {
  id           String   @id @default(uuid())
  coachUserId  String
  title        String
  goal         String?
  notes        String?
  weeksCount   Int      @default(4)
  periodDays   Int      @default(7)
  status       String   // 'draft' | 'published' | 'archived'
  planType     String   @default("personal") // 'personal' | 'gym' | 'self_guided' | 'ai'
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coach       User             @relation("CoachPlans", fields: [coachUserId], references: [id], onDelete: Restrict)
  assignments PlanAssignment[]
  weeks       PlanWeek[]
  workouts    PlanWorkout[]

  @@index([coachUserId])
}

model PlanAssignment {
  id           String    @id @default(uuid())
  planId       String
  clientUserId String
  startDate    DateTime? @db.Date
  status       String    // 'active' | 'paused' | 'finished'
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plan   Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  client User @relation(fields: [clientUserId], references: [id], onDelete: Restrict)

  @@index([clientUserId, status])
  @@index([planId])
}

model PlanWeek {
  id         String   @id @default(uuid())
  planId     String
  weekNumber Int
  title      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan             Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  workoutTemplates WorkoutTemplate[]
  workouts         PlanWeekWorkout[]

  @@unique([planId, weekNumber])
}

model PlanWeekWorkout {
  id               String   @id @default(uuid())
  planWeekId       String
  workoutTemplateId String
  sortOrder        Int      @default(0)
  progressionNote  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  planWeek        PlanWeek        @relation(fields: [planWeekId], references: [id], onDelete: Cascade)
  workoutTemplate WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  sessions        WorkoutSession[]

  @@index([planWeekId, sortOrder])
  @@index([workoutTemplateId])
}

model WorkoutTemplate {
  id          String   @id @default(uuid())
  planWeekId  String?
  coachUserId String?
  type        String   @default("strength")
  title       String
  description String?
  tags        String[] @default([])
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planWeek         PlanWeek?         @relation(fields: [planWeekId], references: [id], onDelete: Cascade)
  coach            User?             @relation("CoachWorkoutTemplates", fields: [coachUserId], references: [id], onDelete: Restrict)
  workoutExercises WorkoutExercise[]
  workoutBlocks    WorkoutBlock[]
  workoutSessions  WorkoutSession[]
  scheduledInWeeks PlanWeekWorkout[]
  inPlans          PlanWorkout[]
  gymClasses        GymClass[]

  @@index([planWeekId])
  @@index([coachUserId])
}

model WorkoutBlock {
  id                          String   @id @default(uuid())
  workoutTemplateId           String
  sortOrder                   Int      @default(0)
  type                        String   // 'warmup' | 'strength' | 'intervals' | 'cardio' | 'cooldown'
  label                       String?
  description                 String?  // coach notes about this block
  restAfterSeconds            Int?     // rest after completing this block (before next block)

  // ── Interval-specific config (type = 'intervals') ──
  intervalType                String?  // 'tabata' | 'hiit' | 'emom' | 'amrap'
  workSeconds                 Int?     // seconds of work per interval
  restSeconds                 Int?     // seconds of rest between intervals
  rounds                      Int?     // number of rounds
  totalDurationSeconds        Int?     // total block time (amrap/emom)
  restBetweenExercisesSeconds Int?     // rest between exercises within interval block

  // ── Cardio-specific config (type = 'cardio') ──
  targetMinutes               Int?     // target duration in minutes
  targetZone                  String?  // target zone (e.g., "zona 2", "70-80% FCm")

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  workoutTemplate WorkoutTemplate  @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]

  @@index([workoutTemplateId, sortOrder])
}

model PlanWorkout {
  id               String   @id @default(uuid())
  planId           String
  workoutTemplateId String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  workoutTemplate WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)

  @@unique([planId, workoutTemplateId])
  @@index([planId, sortOrder])
  @@index([workoutTemplateId])
}

model Exercise {
  id            String   @id @default(uuid())
  coachUserId   String?
  name          String
  primaryMuscle String?
  equipment     String?
  difficulty    String?  // 'beginner' | 'intermediate' | 'advanced'
  objective     String?  // 'strength' | 'hypertrophy' | 'conditioning' | 'mobility' | 'skill'
  isSystem      Boolean  @default(false)
  youtubeUrl    String?
  source        String?
  sourceId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coach User? @relation("CoachExercises", fields: [coachUserId], references: [id], onDelete: Restrict)

  workoutExercises              WorkoutExercise[]
  workoutExerciseAlternatives   WorkoutExerciseAlternative[]
  plannedInSessionExercises     WorkoutSessionExercise[]     @relation("PlannedExercise")
  performedInSessionExercises   WorkoutSessionExercise[]     @relation("PerformedExercise")
  media                         ExerciseMedia[]
  favoritedBy                   CoachExerciseFavorite[]

  @@unique([coachUserId, name])
  @@unique([source, sourceId])
  @@index([coachUserId])
  @@index([isSystem])
}

model CoachExerciseFavorite {
  id          String   @id @default(uuid())
  coachUserId String
  exerciseId  String
  createdAt   DateTime @default(now())

  coach    User     @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([coachUserId, exerciseId])
  @@index([coachUserId, createdAt(sort: Desc)])
  @@index([exerciseId])
}

model WorkoutExercise {
  id                String   @id @default(uuid())
  workoutTemplateId String
  exerciseId        String
  sortOrder         Int      @default(0)
  supersetGroup     String?  // 'A' | 'B' | 'C' ... — groups exercises into biseries/triseries/circuits
  workoutBlockId    String   // ALL exercises belong to a block (warmup/strength/intervals/cooldown)
  targetSets        Int?
  targetReps        String?
  durationSeconds   Int?     // if set, exercise is timed (replaces reps)
  targetLoadNote    String?
  intensityType     String?  // 'rpe' | 'rir' | 'none'
  intensityTarget   Decimal?
  restSeconds       Int?     // rest after this exercise (within the block)
  tempo             String?
  notes             String?
  groupNote         String?  // coach note shown next to superset group label (first exercise of group only)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workoutTemplate        WorkoutTemplate              @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise               Exercise                     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutBlock           WorkoutBlock                 @relation(fields: [workoutBlockId], references: [id], onDelete: Cascade)
  alternatives           WorkoutExerciseAlternative[]
  workoutSessionExercises WorkoutSessionExercise[]

  @@index([workoutTemplateId])
  @@index([exerciseId])
  @@index([workoutBlockId])
}

model WorkoutExerciseAlternative {
  id                    String   @id @default(uuid())
  workoutExerciseId     String
  alternativeExerciseId String
  priority              Int      @default(0)
  note                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workoutExercise     WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  alternativeExercise Exercise        @relation(fields: [alternativeExerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutExerciseId, alternativeExerciseId])
  @@index([workoutExerciseId, priority])
}

model WorkoutSession {
  id                String   @id @default(uuid())
  clientUserId      String
  workoutTemplateId String?
  planWeekWorkoutId String?
  gymClassId        String?
  performedAt       DateTime @db.Timestamptz
  completedAt       DateTime? @db.Timestamptz
  status            String   // 'in_progress' | 'completed' | 'discarded' | 'pending'
  energyRating      Int?
  sessionNotes      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client          User                     @relation(fields: [clientUserId], references: [id], onDelete: Restrict)
  workoutTemplate WorkoutTemplate?         @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)
  planWeekWorkout  PlanWeekWorkout?        @relation(fields: [planWeekWorkoutId], references: [id], onDelete: SetNull)
  gymClass        GymClass?                @relation(fields: [gymClassId], references: [id], onDelete: SetNull)
  exercises       WorkoutSessionExercise[]
  comments        SessionComment[]

  @@index([clientUserId, performedAt(sort: Desc)])
  @@index([workoutTemplateId])
  @@index([planWeekWorkoutId])
  @@index([gymClassId])
  @@unique([clientUserId, gymClassId])
}

model WorkoutSessionExercise {
  id                  String   @id @default(uuid())
  workoutSessionId    String
  workoutExerciseId   String?
  plannedExerciseId   String?
  performedExerciseId String
  sortOrder           Int      @default(0)
  swapReason          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workoutSession    WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  workoutExercise   WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)
  plannedExercise   Exercise?        @relation("PlannedExercise", fields: [plannedExerciseId], references: [id], onDelete: SetNull)
  performedExercise Exercise         @relation("PerformedExercise", fields: [performedExerciseId], references: [id], onDelete: Restrict)
  sets              WorkoutSet[]

  @@index([workoutSessionId])
  @@index([performedExerciseId])
}

model WorkoutSet {
  id                       String   @id @default(uuid())
  workoutSessionExerciseId String
  setNumber                Int
  reps                     Int?
  durationSeconds          Int?     // actual seconds completed (for timed exercises)
  weight                   Decimal?
  rpe                      Decimal?
  rir                      Decimal?
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workoutSessionExercise WorkoutSessionExercise @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionExerciseId, setNumber])
}

model SessionComment {
  id           String   @id @default(uuid())
  sessionId    String
  authorUserId String
  text         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([authorUserId, createdAt(sort: Desc)])
}

model ChatThread {
  id          String   @id @default(uuid())
  coachUserId String
  clientUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coach  User @relation("ChatCoach", fields: [coachUserId], references: [id], onDelete: Restrict)
  client User @relation("ChatClient", fields: [clientUserId], references: [id], onDelete: Restrict)
  messages ChatMessage[]

  @@unique([coachUserId, clientUserId])
  @@index([coachUserId])
  @@index([clientUserId])
}

model ChatMessage {
  id          String   @id @default(uuid())
  threadId    String
  authorUserId String
  text        String   @default("")
  refKind     String?
  refId       String?
  refLabel    String?
  refMeta     Json?
  mediaType   String?  // 'image' | 'video'
  mediaUrl    String?
  mediaPublicId String?
  mediaWidth  Int?
  mediaHeight Int?
  mediaBytes  Int?
  mediaDurationSeconds Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@index([authorUserId, createdAt(sort: Desc)])
}

model BodyMetricEntry {
  id             String   @id @default(uuid())
  clientUserId   String
  measuredAt     DateTime @db.Date
  weightKg       Decimal?
  waistCm        Decimal?
  chestCm        Decimal?
  hipsCm         Decimal?
  armCm          Decimal?
  thighCm        Decimal?
  notes          String?
  shareWithCoach Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client User @relation(fields: [clientUserId], references: [id], onDelete: Restrict)

  @@index([clientUserId, measuredAt(sort: Desc)])
}

model DailyHealthEntry {
  id           String   @id @default(uuid())
  clientUserId String
  day          DateTime @db.Date
  steps        Int?
  sleepMinutes Int?
  sportType    String?
  sportMinutes Int?
  notes        String?
  source       String   @default("manual")  // 'manual' | 'garmin' | 'google_health' | 'strava'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client User @relation(fields: [clientUserId], references: [id], onDelete: Restrict)

  @@unique([clientUserId, day])
  @@index([clientUserId, day(sort: Desc)])
}

model HealthCoachNote {
  id           String   @id @default(uuid())
  coachUserId  String
  clientUserId String
  day          DateTime @db.Date
  text         String
  createdAt    DateTime @default(now())

  coach  User @relation("HealthNotesCoach", fields: [coachUserId], references: [id], onDelete: Restrict)
  client User @relation("HealthNotesClient", fields: [clientUserId], references: [id], onDelete: Restrict)

  @@index([coachUserId, createdAt(sort: Desc)])
  @@index([clientUserId, day(sort: Desc)])
}

model ExerciseMedia {
  id           String   @id @default(uuid())
  exerciseId   String
  mediaType    String   // 'image' | 'video'
  url          String   // Cloudinary secure_url o YouTube URL
  publicId     String?  // Cloudinary public_id (para transformaciones/borrar)
  width        Int?     // Dimensiones originales
  height       Int?
  fileSize     Int?     // Bytes
  duration     Float?   // Segundos (solo videos)
  isPrimary    Boolean  @default(false) // Thumbnail principal
  displayOrder Int      @default(0)     // Orden de visualización
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, displayOrder])
  @@index([exerciseId, isPrimary])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    // 'new_message' | 'plan_assigned' | 'client_added' | 'session_completed'
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model FoodLogEntry {
  id           String   @id @default(uuid())
  clientUserId String
  loggedAt     DateTime @db.Timestamptz
  text         String?
  photoUrl     String?
  source       String   @default("manual")
  sourceRef    String?
  mealType     String?
  quality      String?
  macroTags    String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client User @relation(fields: [clientUserId], references: [id], onDelete: Restrict)

  coachComments FoodCoachComment[]

  @@index([clientUserId, loggedAt(sort: Desc)])
}

model FoodCoachComment {
  id        String   @id @default(uuid())
  foodId    String
  coachUserId String
  text      String
  createdAt DateTime @default(now())

  food  FoodLogEntry @relation(fields: [foodId], references: [id], onDelete: Cascade)
  coach User         @relation("FoodCoachCommentCoach", fields: [coachUserId], references: [id], onDelete: Restrict)

  @@index([foodId, createdAt(sort: Desc)])
  @@index([coachUserId, createdAt(sort: Desc)])
}

model HealthGoal {
  id               String    @id @default(uuid())
  clientUserId     String
  kind             String
  targetNumber     Decimal?
  targetInt        Int?
  unit             String
  period           String
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  shareWithCoach   Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client User @relation(fields: [clientUserId], references: [id], onDelete: Restrict)

  @@index([clientUserId, startDate(sort: Desc)])
  @@index([clientUserId, kind])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  badgeId     String
  unlockedAt  DateTime @default(now())
  viewed      Boolean  @default(false) // Track if user has seen the badge

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model HealthDataSync {
  id              String   @id @default(uuid())
  userId          String
  provider        String   // 'google_fit' | 'apple_health' | 'garmin' | 'fitbit'
  providerUserId  String?
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  lastSyncAt      DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model HealthProviderConnection {
  id              String   @id @default(uuid())
  userId          String
  provider        String   // 'garmin' | 'google_health' | 'strava'
  providerUserId  String?
  accessToken     String?  @db.Text
  refreshToken    String?  @db.Text
  tokenExpiresAt  DateTime?
  scope           String[] @default([])
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // 'success' | 'partial' | 'failed'
  lastError       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncedActivities HealthSyncedActivity[]

  @@unique([userId, provider])
  @@index([userId, isActive])
}

model NotificationSettings {
  id                 String    @id @default(uuid())
  userId             String    @unique
  workoutReminder    Boolean   @default(false)
  reminderTime       String    @default("09:00")        // HH:MM 24h format
  reminderDays       String[]  @default(["monday","tuesday","wednesday","thursday","friday","saturday","sunday"])
  inactivityAlert    Boolean   @default(false)
  inactivityDays     Int       @default(3)              // days without workout before alert
  weeklySummary      Boolean   @default(false)
  weeklySummaryDay   String    @default("sunday")       // day of week to send
  emailNotifications Boolean   @default(false)
  pushNotifications   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HealthSyncedActivity {
  id               String   @id @default(uuid())
  userId           String
  connectionId     String
  provider         String   // 'garmin' | 'google_health' | 'strava'
  providerRef      String   // ID externo para deduplicar

  // Datos normalizados
  date             DateTime @db.Date
  steps            Int?
  distanceMeters   Int?
  calories         Float?
  activeMinutes    Int?

  // Sleep
  sleepMinutes     Int?
  deepSleepMinutes Int?
  lightSleepMinutes Int?
  remSleepMinutes  Int?

  // Heart
  restingHeartRate Int?
  avgHeartRate     Int?
  maxHeartRate     Int?

  // Garmin-specific (opcional)
  stress           Int?
  bodyBattery      Int?
  spo2             Float?

  // Activity summary
  activityType     String?  // 'run' | 'walk' | 'cycle' | 'swim' | 'workout'
  activityMinutes  Int?

  // Metadata
  rawData          Json?    // para debug o features futuras
  syncedAt         DateTime @default(now())

  connection       HealthProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerRef])
  @@index([userId, date(sort: Desc)])
  @@index([connectionId])
}

// ─────────────────────────────────────────────────────────────
// Challenges / Gamification
// ─────────────────────────────────────────────────────────────

model Challenge {
  id          String   @id @default(uuid())
  type        String   // '30_day' | 'weekly_volume' | 'coach_challenge' | 'community'
  title       String
  description String?
  
  // Challenge configuration
  targetValue Float    // Target value to complete (e.g., 30 workouts, 10000 kg volume)
  unit        String   // 'workouts' | 'volume' | 'steps' | 'minutes'
  
  // Time period
  startDate   DateTime
  endDate     DateTime?
  durationDays Int?    // For fixed duration challenges
  
  // Creator (null = global/system challenge)
  createdByCoachId String?
  coach     User?    @relation("CoachChallenges", fields: [createdByCoachId], references: [id], onDelete: SetNull)
  
  // For coach challenges - target specific group
  targetGroupId String?
  group     CoachGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  
  // Visibility
  isPublic    Boolean  @default(true)
  isActive    Boolean  @default(true)
  
  // Rewards
  xpReward    Int      @default(200)
  badgeId     String?  // Optional badge for completing
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  participants ChallengeParticipant[]
  
  @@index([isPublic, isActive])
  @@index([createdByCoachId])
  @@index([startDate])
}

model ChallengeParticipant {
  id          String   @id @default(uuid())
  
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Progress
  currentValue Float   @default(0)
  completedAt  DateTime?
  
  // Ranking info
  rank         Int?
  
  // Notifications
  lastProgressNotifiedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([challengeId, userId])
  @@index([userId])
  @@index([challengeId, currentValue(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Social / Friends System
// ─────────────────────────────────────────────────────────────

model UserFollow {
  id          String   @id @default(uuid())
  
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ─────────────────────────────────────────────────────────────
// Athlete Solo / Self-Service Mode
// ─────────────────────────────────────────────────────────────

model AthleteOnboarding {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Onboarding preferences
  goal            String   // 'lose_weight' | 'build_muscle' | 'maintain' | 'improve_endurance' | 'general_fitness'
  experience      String   // 'beginner' | 'intermediate' | 'advanced'
  daysPerWeek     Int      // 2-6
  sessionDuration Int      // 30, 45, 60, 90
  equipment       String[] // ['gym', 'dumbbells', 'home', 'bodyweight']
  focusAreas      String[] // ['upper', 'lower', 'core', 'cardio', 'full_body']
  
  // AI recommendations generated
  aiRecommendations Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
}
