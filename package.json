{
  "name": "regen-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @regen/api dev",
    "dev:web": "pnpm --filter @regen/web dev",
    "build:api": "pnpm --filter @regen/api build",
    "build:web": "pnpm --filter @regen/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @regen/api db:generate",
    "db:migrate": "pnpm --filter @regen/api db:migrate",
    "db:studio": "pnpm --filter @regen/api db:studio",
    "db:seed": "pnpm --filter @regen/api db:seed"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
